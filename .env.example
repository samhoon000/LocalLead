# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
BUSINESS_DATA_PROVIDER=geoapify
BUSINESS_DATA_PROVIDER_API_KEY=
GEOAPIFY_API_KEY=
WEBSITE_ENRICHMENT_API_KEY=
WEBSITE_ANALYSIS_ENABLED=true
WEBSITE_ANALYSIS_TIMEOUT_MS=8000
PROVIDER_REQUEST_DELAY_MS=250
PROVIDER_MAX_RETRIES=3

# Set true only for local/demo use. Production should use Supabase Auth.
DEMO_MODE=false
